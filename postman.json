              "raw": "{\n    \"card_number\": \"4242424242424242\",\n    \"expiry_month\": \"12\",\n    \"expiry_year\": \"28\",\n    \"cvv\": \"123\",\n    \"amount\": 150.00,\n    \"currency\": \"USD\"\n}"
            },
            "url": {
              "raw": "http://localhost:8000/api/payments/process/",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["api", "payments", "process", ""]
            }
          }
